# ChainGuard environment variables
# Copy this file to `.env` and fill in values. Never commit `.env`.

# Public base URL of the ChainGuard evidence API.
# This is exposed to the browser, so it must never contain secrets.
# Defaults to the deployed hackathon backend if unset.
PUBLIC_CHAINGUARD_API_BASE_URL="https://chainguard.up.railway.app"

# Optional local TypeORM / PostgreSQL connection.
# The core product talks to the remote evidence API and does NOT require a local
# database. Only set this if you want the optional local custody queue.
# DATABASE_URL="postgres://user:password@host:port/db-name"

# Origin used by SvelteKit for form actions and adapter environments.
ORIGIN="http://localhost:5173"
