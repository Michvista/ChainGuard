# ChainGuard environment variables
# Copy this file to `.env` and fill in values. Never commit `.env`.

# Public base URL of the ChainGuard evidence API.
# This is exposed to the browser, so it must never contain secrets.
# Defaults to the deployed hackathon backend if unset.
PUBLIC_CHAINGUARD_API_BASE_URL="https://chainguard.up.railway.app"

# Origin used by SvelteKit for form actions and adapter environments.
ORIGIN="http://localhost:5173"